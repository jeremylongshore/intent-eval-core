new file mode 100644
index 0000000000000000000000000000000000000000..2aab455bb931addf218f343d59084c3445a9eb10
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,24 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm. Check iteratively before
+// entering a recursive AST walker, including callers supplying an AST.
+const MAX_DEPTH = 64;
+const checkDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError('Brace pattern exceeds maximum nesting depth (64)');
+    }
+    if (node && typeof node === 'object') {
+      if (seen.has(node)) throw new SyntaxError('Brace AST contains repeated nodes');
+      seen.add(node);
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+checkDepth.MAX_DEPTH = MAX_DEPTH;
+module.exports = checkDepth;
