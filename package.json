{
  "name": "@intentsolutions/core",
  "version": "0.11.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "description": "The spec authority kernel for agent-native artifacts — shared runtime and authoring contracts for the Intent Eval Platform.",
  "keywords": [
    "intent-eval",
    "contracts",
    "kernel",
    "zod",
    "json-schema",
    "evidence-bundle"
  ],
  "homepage": "https://github.com/jeremylongshore/intent-eval-core",
  "bugs": "https://github.com/jeremylongshore/intent-eval-core/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremylongshore/intent-eval-core.git"
  },
  "license": "Apache-2.0",
  "author": "Jeremy Longshore <jeremy@intentsolutions.io>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*.json": "./schemas/v1/*.json",
    "./schemas/v1": "./schemas/v1/index.json",
    "./schemas/authoring/v1/*.json": "./schemas/authoring/v1/*.json",
    "./schemas/authoring/v1": "./schemas/authoring/v1/index.json",
    "./schemas/authoring/v2/*.json": "./schemas/authoring/v2/*.json",
    "./schemas/authoring/v2": "./schemas/authoring/v2/index.json",
    "./validators/v1": {
      "types": "./dist/validators/v1/index.d.ts",
      "import": "./dist/validators/v1/index.js"
    },
    "./validators/v1/authoring": {
      "types": "./dist/validators/v1/authoring/index.d.ts",
      "import": "./dist/validators/v1/authoring/index.js"
    },
    "./validators/v1/authoring/v2": {
      "types": "./dist/validators/v1/authoring/v2/index.d.ts",
      "import": "./dist/validators/v1/authoring/v2/index.js"
    },
    "./validators/v1/*": {
      "types": "./dist/validators/v1/*.d.ts",
      "import": "./dist/validators/v1/*.js"
    },
    "./otel/v1": {
      "types": "./dist/otel/v1/index.d.ts",
      "import": "./dist/otel/v1/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "codegen:validators": "node --experimental-strip-types scripts/codegen-validators.ts",
    "codegen:authoring": "node --experimental-strip-types scripts/codegen-authoring.ts",
    "codegen:authoring:check": "node --experimental-strip-types scripts/codegen-authoring.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsd",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "audit-harness arch",
    "boundaries": "node --experimental-strip-types scripts/check-boundaries.ts",
    "check:predicate-namespace": "node --experimental-strip-types scripts/check-predicate-namespace-isolation.ts",
    "check:chamber-isolation": "node --experimental-strip-types scripts/check-chamber-isolation.ts",
    "check:rubric-floor": "node --experimental-strip-types scripts/check-rubric-floor.ts",
    "check:prose-anchors": "node --experimental-strip-types scripts/check-prose-anchors.ts",
    "check:coverage-map": "node --experimental-strip-types scripts/check-coverage-map-completeness.ts",
    "check:coverage-map-prose-anchors": "node --experimental-strip-types scripts/check-coverage-map-prose-anchors.ts",
    "check:is-extension-rationale": "node --experimental-strip-types scripts/check-is-extension-rationale.ts",
    "check:changelog-observance": "node --experimental-strip-types scripts/check-changelog-observance.ts",
    "codegen:prose-anchors": "node --experimental-strip-types scripts/parse-spec-headings.ts",
    "codegen:pydantic": "python3 scripts/codegen_pydantic.py",
    "codegen:pydantic:check": "python3 scripts/codegen_pydantic.py --check",
    "check:version-lockstep": "python3 scripts/check_version_lockstep.py",
    "api:extract": "pnpm run build && api-extractor run --local",
    "api:check": "pnpm run build && api-extractor run",
    "api:diff": "node --experimental-strip-types scripts/api-diff.ts",
    "harness:verify": "audit-harness verify",
    "harness:init": "audit-harness init",
    "check": "pnpm run codegen:validators:check && pnpm run codegen:authoring:check && pnpm run check:predicate-namespace && pnpm run check:chamber-isolation && pnpm run check:rubric-floor && pnpm run check:prose-anchors && pnpm run check:coverage-map && pnpm run check:coverage-map-prose-anchors && pnpm run check:is-extension-rationale && pnpm run check:version-lockstep && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run arch && pnpm run boundaries",
    "codegen:validators:check": "node --experimental-strip-types scripts/codegen-validators.ts --check"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "tsd": {
    "directory": "test-d"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@intentsolutions/audit-harness": "^1.4.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@microsoft/api-extractor-model": "^7.33.15",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "json-schema-to-zod": "^2.8.1",
    "lint-staged": "^17.6.0",
    "markdown-it": "14.3.3",
    "prettier": "^3.8.3",
    "tsd": "^0.33.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "sprintf-js@1.0.3": "patches/sprintf-js@1.0.3.patch"
    }
  }
}
