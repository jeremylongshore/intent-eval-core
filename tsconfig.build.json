{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // allowImportingTsExtensions is incompatible with emit; the base config sets
    // it for the scripts/ typecheck only. The build compiles src/** (no .ts-ext
    // imports), so turn it off here to permit emission.
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest.config.ts",
    "src/validators/v1/_generated/**"
  ]
}
