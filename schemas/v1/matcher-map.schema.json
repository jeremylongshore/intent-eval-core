{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/intent-eval-core/schemas/v1/matcher-map.schema.json",
  "title": "MatcherMap — reusable input→behavior pattern definition (Blueprint B § 2.3)",
  "description": "State machine: draft → published → deprecated (one-way). Immutable once published; revisions = new row + incremented version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mm_class",
    "name",
    "input_pattern",
    "expected_behavior",
    "version",
    "content_hash",
    "description",
    "created_at",
    "created_by"
  ],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "mm_class": { "$ref": "_common.schema.json#/$defs/mmClass" },
    "name": { "$ref": "_common.schema.json#/$defs/kebabSlug" },
    "input_pattern": {
      "description": "Typed input pattern — closed 3-variant discriminated union per Blueprint B § 2.3 line 159.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": { "const": "regex" },
            "pattern": { "type": "string" },
            "flags": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "json-schema" },
            "schema": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "matcher"],
          "properties": {
            "kind": { "const": "structural" },
            "matcher": {
              "description": "Structural-matcher payload — LOCKED per deferral-B (bd_000-projects-ra9a). A conjunction of path-anchored constraints over the candidate's parsed tree.",
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "constraints"],
              "properties": {
                "mode": {
                  "type": "string",
                  "description": "v1 fixes `all` (every constraint must hold); reserved for a future additive `any`.",
                  "enum": ["all"]
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "op"],
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "Dotted/bracketed accessor into the candidate's parsed tree. Accessor grammar is the runtime's concern.",
                        "minLength": 1
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "exists",
                          "absent",
                          "equals",
                          "type-is",
                          "matches",
                          "length-equals"
                        ]
                      },
                      "value": {
                        "description": "Required for value-bearing ops (equals/type-is/matches/length-equals); omitted for presence ops (exists/absent). Cross-field enforced at the validator layer."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "expected_behavior": {
      "description": "Typed expected behavior. v1 named variants + open extension slot per spec's explicit 'etc.' trailer.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["exact", "semantic", "contract-conformance", "redaction-confirmed"]
            },
            "payload": {}
          }
        },
        {
          "type": "object",
          "required": ["kind", "payload", "extension"],
          "additionalProperties": true,
          "properties": {
            "kind": { "type": "string" },
            "payload": {},
            "extension": { "const": true }
          }
        }
      ]
    },
    "version": { "$ref": "_common.schema.json#/$defs/semver" },
    "content_hash": { "$ref": "_common.schema.json#/$defs/sha256" },
    "description": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "_common.schema.json#/$defs/rfc3339" },
    "created_by": { "$ref": "_common.schema.json#/$defs/actorIdentity" }
  }
}
