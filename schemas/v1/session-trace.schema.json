{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/intent-eval-core/schemas/v1/session-trace.schema.json",
  "title": "SessionTrace — OTel-compatible execution trace for an EvalRun (Blueprint B § 2.10)",
  "description": "State machine: open → closed (closed terminal). 1:1 cardinality with EvalRun. Trace blob content-addressed (tamper-evident) in object storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "eval_run_id",
    "created_at",
    "closed_at",
    "root_span_id",
    "total_spans",
    "max_loop_depth",
    "total_tool_invocations",
    "total_judge_decisions",
    "trace_blob_storage_key"
  ],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "eval_run_id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "created_at": { "$ref": "_common.schema.json#/$defs/rfc3339" },
    "closed_at": {
      "oneOf": [{ "$ref": "_common.schema.json#/$defs/rfc3339" }, { "type": "null" }]
    },
    "root_span_id": { "$ref": "_common.schema.json#/$defs/otelSpanId" },
    "total_spans": { "type": "integer", "minimum": 0 },
    "max_loop_depth": { "type": "integer", "minimum": 0 },
    "total_tool_invocations": { "type": "integer", "minimum": 0 },
    "total_judge_decisions": { "type": "integer", "minimum": 0 },
    "trace_blob_storage_key": { "$ref": "_common.schema.json#/$defs/storageKey" }
  }
}
