{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/intent-eval-core/schemas/v1/eval-spec.schema.json",
  "title": "EvalSpec \u2014 declarative evaluation specification (Blueprint B \u00a7 2.1)",
  "description": "Content-addressed via content_hash. State machine: draft \u2192 published \u2192 deprecated (deprecated reversible to published). Mutable in draft; immutable once published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "description",
    "matchers",
    "assertions",
    "scoring",
    "composition",
    "expected_artifacts",
    "runtime_limits",
    "provider_constraints",
    "created_at",
    "created_by",
    "content_hash"
  ],
  "properties": {
    "id": {
      "$ref": "_common.schema.json#/$defs/uuidv7"
    },
    "version": {
      "$ref": "_common.schema.json#/$defs/semver"
    },
    "name": {
      "$ref": "_common.schema.json#/$defs/kebabSlug"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "matchers": {
      "type": "array",
      "description": "MatcherMap FKs.",
      "items": {
        "$ref": "_common.schema.json#/$defs/uuidv7"
      }
    },
    "assertions": {
      "type": "array",
      "description": "Legacy named assertions retain open targets; trajectory assertions have strict typed targets. extension:true payloads remain opaque, including class-name collisions. Class-2 proposal 014 is awaiting ratification.",
      "items": {
        "type": "object",
        "required": ["class", "target"],
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "output-equals",
                  "output-contains",
                  "output-matches",
                  "schema-conforms",
                  "judge-verdict",
                  "matcher-satisfied"
                ]
              },
              "target": {},
              "negate": {
                "type": "boolean"
              }
            }
          },
          {
            "additionalProperties": false,
            "required": ["class", "target", "extension"],
            "properties": {
              "class": {
                "type": "string"
              },
              "target": {},
              "negate": {
                "type": "boolean"
              },
              "extension": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "target"],
            "properties": {
              "class": {
                "type": "string",
                "const": "tool-called"
              },
              "target": {
                "$ref": "#/$defs/ToolCalledTarget"
              },
              "negate": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "target"],
            "properties": {
              "class": {
                "type": "string",
                "const": "tool-not-called"
              },
              "target": {
                "$ref": "#/$defs/TrajectoryToolMatcher"
              },
              "negate": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "target"],
            "properties": {
              "class": {
                "type": "string",
                "const": "order-before"
              },
              "target": {
                "$ref": "#/$defs/OrderBeforeTarget"
              },
              "negate": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "target"],
            "properties": {
              "class": {
                "type": "string",
                "const": "file-exists"
              },
              "target": {
                "$ref": "#/$defs/FileExistsTarget"
              },
              "negate": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "target"],
            "properties": {
              "class": {
                "type": "string",
                "const": "file-matches-sha-in"
              },
              "target": {
                "$ref": "#/$defs/FileMatchesShaInTarget"
              },
              "negate": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "scoring": {
      "type": "object",
      "description": "Scoring configuration. aggregation_rule is the spec-bound field per Blueprint B \u00a7 2.1. weight_dimension/weights/tiebreaker are the deferral-C lockup (bd_000-projects-21re), additive + optional. \u00a7 7.6 architectural rule: ship/no-ship THRESHOLDS belong in consumer-side tests/TESTING.md, NOT here \u2014 only weights + exact-tie resolution are kernel-side.",
      "required": ["aggregation_rule"],
      "properties": {
        "aggregation_rule": {
          "type": "string",
          "enum": ["majority", "unanimous", "weighted"]
        },
        "weight_dimension": {
          "type": "string",
          "description": "Dimension the weighted rule distributes over (deferral-C, bd_000-projects-21re). Required when `weights` present; ignored otherwise.",
          "enum": ["matcher", "mm-class", "judge"]
        },
        "weights": {
          "type": "array",
          "description": "Per-unit weights for the weighted rule (deferral-C). Normalized by their sum at scoring time.",
          "items": {
            "type": "object",
            "required": ["key", "weight"],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "tiebreaker": {
          "type": "string",
          "description": "Deterministic resolution of an exact aggregate tie (deferral-C). NOT a threshold \u2014 it resolves a tie, it does not set a pass bar.",
          "enum": ["fail-closed", "fail-open", "first-listed"]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Tool-specific scoring metadata. MUST NOT drive ship/no-ship decisions (mirrors \u00a7 7.4 metadata rule)."
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "DAG declaration per Blueprint B \u00a7 1.3. Validation contract: runtime topologically sorts; cycles rejected at submission with 400. Wire format (adjacency list with typed edges) is engineer's choice per bd_000-projects-3sjx; semantics ARE spec-bound (node types + edge kinds + failure propagation per \u00a7 1.3 line 100).",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "ref"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Local-to-DAG node identifier (unique within composition)."
              },
              "kind": {
                "type": "string",
                "description": "Node type per Blueprint B \u00a7 1.3 line 92.",
                "enum": ["eval_run", "tool_invocation"]
              },
              "ref": {
                "$ref": "_common.schema.json#/$defs/uuidv7"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind"],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "description": "Edge type \u2014 drives runtime failure-propagation per Blueprint B \u00a7 1.3 line 100.",
                "enum": ["feeds", "gates", "enriches"]
              }
            }
          }
        }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "description": "SkillSnapshot.combined_sha values this spec targets. Anchors on CONTENT (sha), not FK \u2014 rebuilt snapshots with the same combined_sha still satisfy.",
      "items": {
        "$ref": "_common.schema.json#/$defs/sha256"
      }
    },
    "runtime_limits": {
      "type": "object",
      "description": "Resource ceilings applied per EvalRun per Blueprint B \u00a7 2.1.",
      "required": [
        "token_ceiling",
        "wall_clock_ceiling_ms",
        "memory_ceiling_mb",
        "concurrency_hint"
      ],
      "additionalProperties": false,
      "properties": {
        "token_ceiling": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_ceiling_ms": {
          "type": "integer",
          "minimum": 0
        },
        "memory_ceiling_mb": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency_hint": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provider_constraints": {
      "type": "array",
      "description": "Allowlist of provider IDs.",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "$ref": "_common.schema.json#/$defs/rfc3339"
    },
    "created_by": {
      "$ref": "_common.schema.json#/$defs/actorIdentity"
    },
    "content_hash": {
      "$ref": "_common.schema.json#/$defs/sha256"
    },
    "tenant_id": {
      "$ref": "_common.schema.json#/$defs/uuidv7",
      "description": "RESERVED multi-tenancy slot (deferral-G, bd_000-projects-k0fj). OPTIONAL + additive per \u00a7 7.2; tenant-isolation semantics deferred to a future DR. v1 single-tenant specs omit it."
    }
  },
  "$defs": {
    "TrajectoryToolMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input_contains": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ToolCalledTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input_contains": {
          "type": "string",
          "minLength": 1
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "OrderBeforeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "then"],
      "properties": {
        "first": {
          "$ref": "#/$defs/TrajectoryToolMatcher"
        },
        "then": {
          "$ref": "#/$defs/TrajectoryToolMatcher"
        }
      }
    },
    "FileExistsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "ECMAScript regex source without flags. Syntax-validation policy is pending Class-2 record 014."
        },
        "produced": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["pattern"]
        }
      ]
    },
    "FileMatchesShaInTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "ECMAScript regex source without flags. Syntax-validation policy is pending Class-2 record 014."
        },
        "in": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "(^|/)\\.\\.(/|(?![\\s\\S]))"
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": ["path"]
        },
        {
          "required": ["pattern"]
        }
      ]
    }
  }
}
