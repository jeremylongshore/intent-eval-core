{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/intent-eval-core/schemas/v1/judge-decision.schema.json",
  "title": "JudgeDecision — single judge's verdict on an EvalRun for a MatcherMap (Blueprint B § 2.5)",
  "description": "Single terminal state `recorded`. Immutable at creation. Follow-up verdicts = new rows. When emitted as a signed predicate row, the URI is eval-verdict/v1 (currently sigstore_staging).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "eval_run_id",
    "session_trace_id",
    "matcher_map_id",
    "judge_identity",
    "judge_version",
    "verdict",
    "verdict_source",
    "confidence",
    "reasoning",
    "input_hash",
    "seed",
    "evaluated_at",
    "latency_ms",
    "cost_record_ref"
  ],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "eval_run_id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "session_trace_id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "matcher_map_id": { "$ref": "_common.schema.json#/$defs/uuidv7" },
    "judge_identity": {
      "type": "string",
      "description": "Stable judge identity, e.g., `audit-harness@0.3.0:escape-scan`.",
      "minLength": 1
    },
    "judge_version": { "$ref": "_common.schema.json#/$defs/semver" },
    "verdict": {
      "type": "string",
      "description": "Verdict enum per Blueprint B § 2.5 (closed 5-element set). UPPERCASE — deliberately DISTINCT from GateDecision (lowercase).",
      "enum": ["PASS", "FAIL", "ADVISORY", "NOT_APPLICABLE", "ERROR"]
    },
    "verdict_source": {
      "type": "string",
      "description": "How the verdict was reached.",
      "enum": ["deterministic", "llm_with_seed", "llm_no_seed", "hybrid"]
    },
    "confidence": {
      "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }],
      "description": "Populated for LLM judges; null for deterministic judges."
    },
    "reasoning": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "Free-form judge reasoning output."
    },
    "input_hash": { "$ref": "_common.schema.json#/$defs/sha256" },
    "seed": {
      "oneOf": [{ "type": "integer" }, { "type": "string" }, { "type": "null" }],
      "description": "Populated for verdict_source='llm_with_seed'. Blueprint B does not specify integer vs string — both accepted."
    },
    "evaluated_at": { "$ref": "_common.schema.json#/$defs/rfc3339" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost_record_ref": { "$ref": "_common.schema.json#/$defs/uuidv7" }
  }
}
