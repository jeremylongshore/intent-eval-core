{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/intent-eval-core/schemas/authoring/v1/index.json",
  "title": "@intentsolutions/core authoring schema index v1",
  "description": "Catalog of authoring-contract schemas for the Spec Authority Kernel (SAK). Source of truth: ISEDC Session 8 charter DR-044 (intent-eval-lab/000-docs/044-AT-DECR-isedc-council-session-8-sak-charter-2026-06-09.md) + plan 033 § 14.10 / § 14.A. The marketplace-tier foundation exposes the THREE universal folds (deprecationRegistry, securityChecks, disclosureMarkers) + the universalFolds composition that every per-contract schema inherits by reference (D7). Each per-contract contract is three artifacts — an upstream-base (authored by the open standard), an is-overlay (authored by IS), and the published allOf composition. skill-frontmatter is contract #1 (the walking skeleton). The remaining five (plugin-manifest, agent-definition, mcp-config, hook-config, marketplace-catalog) land on-demand behind a CFO bandwidth sign-off, codegen-generated (D8 — codegen is a hard precondition of contract #2).",
  "version": "1.0.0-draft",
  "schemas": {
    "marketplace-tier": {
      "path": "marketplace-tier.schema.json",
      "title": "IS marketplace authoring tier — 3 universal folds + universalFolds composition",
      "kind": "authoring-foundation",
      "spec": "DR-044 D7 / plan 033 § 14.10",
      "universalFolds": ["deprecationRegistry", "securityChecks", "disclosureMarkers"]
    },
    "skill-frontmatter": {
      "path": "skill-frontmatter.schema.json",
      "title": "skill-frontmatter — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 1,
      "spec": "DR-044 D7 / plan 033 § 14.2 / 6767-b §4",
      "layers": {
        "upstreamBase": "upstream-base/skill-frontmatter.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/skill-frontmatter.v1.json"
      },
      "baseRequired": ["name", "description"],
      "overlayRequired": ["allowed-tools", "version", "author", "license", "compatibility", "tags"]
    },
    "plugin-manifest": {
      "path": "plugin-manifest.schema.json",
      "title": "plugin-manifest — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 2,
      "lifecycle": "SHIPPED-INTERNAL",
      "spec": "DR-044 D8 / plan 033 § 14.A / code.claude.com/docs/en/plugins-reference",
      "layers": {
        "upstreamBase": "upstream-base/plugin-manifest.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/plugin-manifest.v1.json"
      },
      "baseRequired": ["name"],
      "overlayRequired": [
        "version",
        "description",
        "author",
        "homepage",
        "license",
        "keywords",
        "commands"
      ]
    },
    "agent-definition": {
      "path": "agent-definition.schema.json",
      "title": "agent-definition — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 3,
      "lifecycle": "SHIPPED-INTERNAL",
      "spec": "DR-044 D8 / plan 033 § 14.A / code.claude.com/docs/en/sub-agents",
      "layers": {
        "upstreamBase": "upstream-base/agent-definition.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/agent-definition.v1.json"
      },
      "baseRequired": ["name", "description"],
      "overlayRequired": ["tools", "model", "color", "version", "author", "tags"]
    },
    "mcp-config": {
      "path": "mcp-config.schema.json",
      "title": "mcp-config — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 4,
      "lifecycle": "SHIPPED-INTERNAL",
      "spec": "DR-044 D8 / plan 033 § 14.A / modelcontextprotocol.io/specification (2025-11-25) + code.claude.com/docs/en/mcp",
      "layers": {
        "upstreamBase": "upstream-base/mcp-config.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/mcp-config.v1.json"
      },
      "baseRequired": ["name", "command", "args", "transport", "env"],
      "overlayRequired": ["description", "version", "enabled"]
    },
    "hook-config": {
      "path": "hook-config.schema.json",
      "title": "hook-config — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 5,
      "lifecycle": "SHIPPED-INTERNAL",
      "spec": "DR-044 D8 / plan 033 § 14.A / code.claude.com/docs/en/hooks + code.claude.com/docs/en/settings",
      "layers": {
        "upstreamBase": "upstream-base/hook-config.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/hook-config.v1.json"
      },
      "baseRequired": ["event", "matcher", "type", "command"],
      "overlayRequired": ["description", "enabled", "timeout", "blocking"]
    },
    "marketplace-catalog": {
      "path": "marketplace-catalog.schema.json",
      "title": "marketplace-catalog — IS marketplace-tier contract (composition)",
      "kind": "authoring-contract",
      "contractIndex": 6,
      "lifecycle": "SHIPPED-INTERNAL",
      "spec": "DR-044 D8 / plan 033 § 14.A / code.claude.com/docs/en/plugin-marketplaces + anthropics/claude-plugins-official",
      "layers": {
        "upstreamBase": "upstream-base/marketplace-catalog.v1.json",
        "universalFolds": "marketplace-tier.schema.json#/$defs/universalFolds",
        "isOverlay": "is-overlay/marketplace-catalog.v1.json"
      },
      "baseRequired": ["name", "owner", "plugins"],
      "overlayRequired": ["version", "description", "license", "homepage", "keywords"]
    }
  }
}
